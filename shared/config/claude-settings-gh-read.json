{
  "disableAllHooks": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)"
    ],
    "deny": [
      "Bash(gh alias:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh config:*)",
      "Bash(gh extension:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh release download:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh run download:*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read(//proc/**)"
    ]
  }
}
