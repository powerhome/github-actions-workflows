{
  "extends": [
    "config:base",
    "group:allNonMajor",
    "local>powerhome/renovate-config:ignore-stalebot-action"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "labels": ["dependencies"],
  "timezone": "America/New_York",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "matchPackageNames": ["rubocop"],
      "allowedVersions": "< 1.45.0"
    }
  ]
}
