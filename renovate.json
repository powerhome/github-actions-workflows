{
  "extends": ["github>powerhome/renovate-config", "group:allNonMajor"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "matchPackageNames": ["rubocop"],
      "allowedVersions": "< 1.45.0"
    }
  ]
}
